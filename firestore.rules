rules_version = '2';

// Flow: one shared Firebase project for all users. Each signed-in user can only read and
// write their own subtree at users/{their Firebase Auth UID}/...
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_quick_capture"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutShortLabel="@string/shortcut_quick_capture_short"
        android:shortcutLongLabel="@string/shortcut_quick_capture_long">
        <intent
            android:action="com.flow.todo.ACTION_QUICK_CAPTURE"
            android:targetPackage="com.flow.todo"
            android:targetClass="com.flow.todo.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

